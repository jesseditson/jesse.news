{%- assign link_url = shared_url -%}
{%- assign show_preview = false -%}
{%- if item.media.size == 0 and link_image != blank -%}{%- assign show_preview = true -%}{%- endif -%}
{%- if link_url != blank -%}
<article class="card card--link{% if open %} is-open{% endif %}{% if item.media.size > 0 or show_preview %} has-media{% endif %}" data-path="{{ item.path }}" data-title="{{ link_title | strip_html }}" data-paper="{{ paper }}" style="--tilt: {{ tilt }}deg">
  <div class="card-paper">
    <header class="card-head card-source">
      <span class="source-name">{{ link_source }}</span>
      <a class="card-permalink" href="/{{ item.path }}.html"><span class="visually-hidden">Permalink, shared </span><time datetime="{{ iso_date }}">{{ pretty_date }}</time></a>
    </header>
    <div class="card-body">
      <div class="link-text">
        <{{ heading }} class="link-title"><a class="card-link" href="{{ link_url }}" target="_blank" rel="noopener">{{ link_title }}</a></{{ heading }}>
        {%- if link_desc != blank %}
        <p class="link-desc">{{ link_desc }}</p>
        {%- endif %}
        {%- assign comment_text = "" -%}
        {%- assign comment_text = comment_html | strip_html | strip -%}
        {%- if comment_text != blank %}
        <div class="link-comment markdown">{{ comment_html }}</div>
        {%- endif %}
        <a class="visit" href="{{ link_url }}" target="_blank" rel="noopener">Visit {{ link_source }} <span aria-hidden="true">&rarr;</span></a>
      </div>
      {%- if show_preview %}
      <figure class="photo photo--preview">
        <img src="{{ link_image }}" alt="{{ link_image_alt }}" loading="lazy" decoding="async">
      </figure>
      {%- endif %}
      {% include 'card-media' %}
    </div>
  </div>
</article>
{%- endif -%}
