<?xml version="1.0" encoding="UTF-8"?>
{%- assign items = posts | where: "created_at" | sort: "created_at" | reverse %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name | escape }}</title>
    <link>{{ site_url }}/</link>
    <description>{{ site.description | escape }}</description>
    <language>en</language>
    <atom:link href="{{ site_url }}/feed.xml" rel="self" type="application/rss+xml"/>
    <lastBuildDate>{{ "now" | date: "%a, %d %b %Y %H:%M:%S %z" }}</lastBuildDate>
    {%- for item in items limit: 50 %}
    <item>
      {%- assign shared_url = "" -%}{%- if item.link -%}{%- if item.link.url -%}{%- assign shared_url = item.link.url -%}{%- endif -%}{%- endif -%}
      {%- if shared_url != blank %}
      {%- assign l = item.link -%}
      {%- assign feed_title = "" -%}
      {%- assign feed_url = "" -%}
      {%- if l -%}{%- if l.title -%}{%- assign feed_title = l.title -%}{%- endif -%}{%- if l.url -%}{%- assign feed_url = l.url -%}{%- endif -%}{%- endif -%}
      {%- if feed_title == blank -%}{%- assign feed_title = feed_url -%}{%- endif %}
      <title>{{ feed_title | escape }}</title>
      <link>{% if feed_url != blank %}{{ feed_url | escape }}{% else %}{{ site_url }}/{{ item.path }}.html{% endif %}</link>
      <description><![CDATA[{% if item.content %}{{ item.content | replace: "]]>", "]]]]><![CDATA[>" }}{% endif %}{% for m in item.media %}{% if m.file %}{% if m.file.type == "image" %}<p><img src="{{ m.file.value.url }}" alt="{% if m.alt %}{{ m.alt | escape }}{% endif %}"></p>{% elsif m.file.type == "video" %}<p><video src="{{ m.file.value.url }}" controls></video></p>{% elsif m.file.type == "audio" %}<p><audio src="{{ m.file.value.url }}" controls></audio></p>{% endif %}{% endif %}{% endfor %}{% if l %}{% if l.description %}<blockquote>{{ l.description | escape }}</blockquote>{% endif %}{% endif %}{% if feed_url != blank %}<p><a href="{{ feed_url | escape }}">{{ feed_url | escape }}</a></p>{% endif %}]]></description>
      {%- else %}
      <title>{% capture feed_title %}{% include 'post-title' %}{% endcapture %}{{ feed_title | escape }}</title>
      <link>{{ site_url }}/{{ item.path }}.html</link>
      <description><![CDATA[{% if item.content %}{{ item.content | replace: "]]>", "]]]]><![CDATA[>" }}{% endif %}{% for m in item.media %}{% if m.file %}{% if m.file.type == "image" %}<p><img src="{{ m.file.value.url }}" alt="{% if m.alt %}{{ m.alt | escape }}{% endif %}"></p>{% elsif m.file.type == "video" %}<p><video src="{{ m.file.value.url }}" controls></video></p>{% elsif m.file.type == "audio" %}<p><audio src="{{ m.file.value.url }}" controls></audio></p>{% endif %}{% endif %}{% endfor %}]]></description>
      {%- endif %}
      <guid isPermaLink="true">{{ site_url }}/{{ item.path }}.html</guid>
      <pubDate>{{ item.created_at | date: "%a, %d %b %Y %H:%M:%S %z" }}</pubDate>
    </item>
    {%- endfor %}
  </channel>
</rss>
